# ── App ──────────────────────────────────────────────────────────
APP_NAME="Immigration AI Platform"
APP_TIMEZONE=Asia/Shanghai
DEBUG=true
SECRET_KEY=your-super-secret-key-change-in-production
APP_DOMAIN=localhost

# Frontend build-time API URL for Vercel/static hosting.
# Leave empty for same-origin Docker/Caddy deployment.
VITE_API_BASE_URL=

# ── Database (local docker) ───────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/immigration_db
# Optional sync URL for Alembic migrations on hosted Postgres.
DATABASE_URL_SYNC=
POSTGRES_DB=immigration_db
POSTGRES_PASSWORD=postgres

# ── Redis (local docker) ─────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CACHE_ENABLED=true
CACHE_TTL_SECONDS=45

# ── Object Storage (local MinIO) ─────────────────────────────────
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin123
STORAGE_BUCKET_NAME=immigration-docs
STORAGE_PUBLIC_URL=http://localhost:9000/immigration-docs
STORAGE_REGION=

# ── LLM provider (fill in yours) ─────────────────────────────────
LLM_PROVIDER=minimax
LLM_MODEL=MiniMax-M2.7
LLM_BASE_URL=https://api.minimax.chat/v1
LLM_API_KEY=
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_SECONDS=900
LLM_TIMEOUT_SECONDS=120

# Legacy named keys (optional)
ANTHROPIC_API_KEY=sk-ant-xxxx
OPENAI_API_KEY=sk-xxxx
GOOGLE_API_KEY=AIzaxxxx
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_LLM=minimax

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── Logging / ops ────────────────────────────────────────────────
LOG_LEVEL=INFO
REQUEST_LOG_ENABLED=true
SQL_ECHO=false
